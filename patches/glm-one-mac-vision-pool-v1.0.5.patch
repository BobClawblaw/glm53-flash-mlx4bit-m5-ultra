+        try readAll(fd, dst, s.off);
+        at += s.len;
+    }
+    // downsample [O, C, 2, 2] -> [O, 2, 2, C]: a merge window's four patch rows, tap by tap
+    const dw: [*]u16 = @ptrCast(@alignCast(w.down_w.addr()));
