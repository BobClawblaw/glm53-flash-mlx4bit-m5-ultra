+                for (dims, shape) |d, *s| {
+                    s.* = @intCast(d.integer);
+                    n *= s.*;
+                }
+                const offs = o.get("data_offsets").?.array.items;
+                const b: u64 = @intCast(offs[0].integer);
+                const e: u64 = @intCast(offs[1].integer);
